__pycache__/
*.pyc
.venv/
.env
data/*
!data/README.md
!data/demo/
logs/
.vscode/

# A `.partial` file is a run that did not reach the end — GenerationWriter
# promotes it to its final name only after the last record, and the whole point
# of the suffix is that an unfinished run must not look like a finished one.
# Committing one puts a truncated measurement in history: `git add -A` during a
# live run swept three into a commit before this line existed.
*.partial

# I campioni dei probe si rigenerano con `probe_index_variants.py sample` ed e'
# deterministico: committarli aggiungerebbe peso senza aggiungere riproducibilita'.
eval/results/probe_samples/

# La ripresa grezza di U-10 e i suoi tempi: `ui/scripts/video.mjs` li rifa' a
# comando, e la GIF che ne esce e' l'unico artefatto che il README mostra.
# Committare anche il .webm raddoppierebbe il peso per una cosa che nessuno
# apre: 2,7 MB contro i 3,5 della GIF, per ogni lingua.
docs/*.webm
docs/*.tempi.json
